---
import '../css/reset.css';
import '../css/spritesheet.css';
import Nav from '../components/Nav.astro';
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg">
    <Nav />
    <slot />
  </body>
</html>
<style is:global>
  /* Global */
  :root {
    font-size: 16px;
    --color-primary: #b09054;
    --color-secondary: #d9c39a;

    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      rgb(var(--accent-light)) 30%,
      white 60%
    );
  }

  @media (max-width: 768px) {
    :root {
      font-size: 14px;
    }
  }

  @font-face {
    font-family: Planewalker;
    src: url('/fonts/Planewalker.otf') format('opentype');
  }

  html {
    font-family: Planewalker, system-ui, sans-serif;
    color: var(--color-primary, #000);
  }

  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }

  body {
    line-height: 1.5rem;
    overflow-x: hidden;
  }

  a {
    text-decoration: underline;
    color: var(--color-primary);
  }
  a:hover {
    color: var(--color-secondary);
    text-decoration: underline;
  }

  /* a:hover {
    text-decoration: underline;
  } */

  h1,
  h2,
  h3,
  h4,
  h5 {
    line-height: 1.2;
  }

  h1 {
    font-size: var(--size-5xl, 5.61rem);
  }

  h2 {
    font-size: var(--size-4xl, 4.209rem);
  }

  h3 {
    font-size: var(--size-3xl, 3.157rem);
  }

  h4 {
    font-size: var(--size-2xl, 2.369rem);
  }

  h5 {
    font-size: var(--size-xl, 1.777rem);
  }

  hr {
    border: 0;
    outline: 1px solid var(--color-primary, #000);
  }

  table {
    border: 1px solid rgba(var(--accent-light), 50%);
    border-collapse: collapse;
    width: 100%;
  }

  th,
  td {
    border: 1px solid rgba(var(--accent-light), 50%);
    padding: 0.5rem 0.25rem;
  }

  @media (max-width: 768px) {
    th,
    td {
      padding: 0;
    }
  }

  @media (max-width: 500px) {
    table {
      font-size: 12px;
    }
  }

  input[type='email'],
  input[type='number'],
  input[type='search'],
  input[type='text'],
  input[type='tel'],
  input[type='url'],
  input[type='password'],
  textarea,
  select {
    height: calc(1rem * 2 + 6px);
    padding: 0.5rem;
    /* background-color: #fff; */
    /* background-color: rgba(255, 255, 255, 0.65); */
    border: 1px solid #d1d1d1;
    border-radius: 0.25rem;
    box-shadow: none;
    width: 100%;
    /* color: #000; */

    background-color: rgba(0, 0, 0, 0.65);
    color: #b09054;
  }

  button,
  input[type='button'],
  input[type='submit'] {
    cursor: pointer;
  }

  ul,
  ol {
    margin: 0;
    padding: 0;
    list-style-type: none;
  }

  :focus,
  :focus-visible {
    outline: 0;
  }

  /* Utilities */
  .bg {
    background-image: url('https://cdn.glitch.com/8539495c-7f63-46fe-ab4b-10d54e3bd285%2Fbg-darkelf.jpg?1526323152198');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    background-attachment: fixed;
  }

  @media (max-width: 768px) {
    .bg {
      background-image: url('https://cdn.glitch.com/8539495c-7f63-46fe-ab4b-10d54e3bd285%2Fbg-darkelf-half.jpg?1526328560089');
      background-position: 65%;
    }
  }

  .hidden {
    display: none;
  }

  .wrapper {
    background-color: rgba(0, 0, 0, 0.65);
    max-width: 70rem;
    margin-left: auto;
    margin-right: auto;
    padding: 1.5rem;
    border-radius: 6px;
  }

  @media (max-width: 768px) {
    .wrapper {
      padding: 0.5rem;
    }
  }

  .flex {
    display: flex;
  }

  .flex-wrap {
    flex-wrap: wrap;
  }

  .flex-col {
    flex-direction: column;
  }

  .flex-1 {
    flex: 1;
  }

  .justify-between {
    justify-content: space-between;
  }

  .grid {
    display: grid;
  }

  .flow > * + * {
    margin-top: var(--flow-space, 1rem);
  }

  .sidebar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .sidebar > :first-child {
    flex-grow: 1;
  }

  .sidebar > :last-child {
    flex-basis: 0;
    flex-grow: 999;
    min-inline-size: 50%;
  }

  @media (max-width: 768px) {
    .sidebar {
      flex-direction: column;
    }
    .sidebar > :first-child {
      order: 2;
      width: 100%;
    }
  }

  .uppercase {
    text-transform: uppercase;
  }

  .opacity-0 {
    opacity: 0;
  }

  .font-size-lg {
    font-size: var(--size-lg);
  }

  .nowrap {
    white-space: nowrap;
  }

  .link {
    text-decoration: underline;
    color: var(--color-primary);
  }

  .link:hover {
    color: var(--color-secondary);
    text-decoration: underline;
  }
</style>
