---
const { text, name, data } = Astro.props;
const id = Math.random().toString(36).slice(2, 11);

function formatId(id) {
  return id.replace(/[()"' ]/g, '');
}
---

<label for="tags-input">{text}</label>
<div id={'tags-field-' + id} class="tags-field">
  <input
    id={'tags-input-' + id}
    class="tags-input"
    name="tags-input"
    autocomplete="off"
  />
</div>

<ul id={'tags-list-' + id} class="tags-list" tabindex="0">
  {
    data.map((o) => (
      <li id={formatId(o)} class="item" tabindex="-1">{o}</li>
    ))
  }
</ul>

<input id={'hidden-input-' + id} class="width-full" name={name} autocomplete="off" />

<script define:vars={{ id: id }}>
  console.log('Init', id);
  let selected = [];
  const $tagsField = document.querySelector('#tags-field-' + id);
  const $searchInput = document.querySelector('#tags-input-' + id);
  const $hiddenInput = document.querySelector('#hidden-input-' + id);
  const $tagsList = document.querySelector('#tags-list-' + id);
  const items = $tagsList.querySelectorAll('li');

  const events = ['click', 'focus'];

  events.forEach((ev) =>
    $tagsField.addEventListener(ev, (e) => {
      $tagsField.classList.add('focus');
      $tagsList.classList.remove('hidden');
      $searchInput.focus();
    })
  );

  $searchInput.addEventListener('keyup', debounce(filterList, 250));

  function filterList(e) {
    if(e?.keyCode === 13) {
      let li = Array.from(items).filter(i => i.classList.contains('highlighted'))[0];
      li.click();
      filter = '';
      $tagsList.classList.add('hidden');
    }
    const filter = $searchInput.value.toLowerCase();
    let firstHighlighted = false;

    Array.from(items).forEach(function (item) {
      const text = item.textContent || item.innerText;
      item.classList.remove('highlighted');

      if (text.toLowerCase().startsWith(filter)) {
        if (filter !== '' && !firstHighlighted) {
          item.classList.add('highlighted');
          firstHighlighted = true;
        }
        item.classList.remove('hidden');
      } else {
        item.classList.add('hidden');
      }
    });
  }

  $tagsList.querySelectorAll('.item').forEach((li) =>
    li.addEventListener('click', (e) => {
      console.log('click', e.target);
      addTag(e.target);
    })
  );

  window.addEventListener('load', (event) => {
    $searchInput.focus();
  });
  
  $searchInput.addEventListener('focusout', (e) => {
    setTimeout(() => {
      $tagsField.classList.remove('focus');
      $tagsList.classList.add('hidden');
    }, 100);
  });

  function debounce(func, delay) {
    let timeoutId;
    return function (...args) {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(() => func.apply(this, args), delay);
    };
  }

  function createTag(el) {
    let name = el.innerText;
    let div = document.createElement('div');
    div.classList.add('tag');
    let span = document.createElement('span');
    span.classList.add('tag-label');
    span.append(name);
    let a = document.createElement('a');
    a.classList.add('remove');
    a.append('x');
    a.addEventListener('click', (e) => {
      div.remove();
      removeTag(el);
    });
    div.append(span);
    div.append(a);

    return div;
  }

  function addTag(el) {
    let value = el.innerText;
    el.classList.add('selected');
    el.classList.remove('highlighted');
    if (selected.indexOf(value) < 0) {
      selected.push(value);
      $tagsField.insertBefore(createTag(el), $searchInput);
      $hiddenInput.value = selected.join(',');
      $searchInput.value = '';
      filterList();
      $searchInput.focus();
      console.log('Added', value);
    }
  }

  function removeTag(el) {
    let value = el.innerText;
    let index = selected.indexOf(value);
    if (index < 0) return;
    selected.splice(index, 1);
    $hiddenInput.value = selected.join(',');
    let item = $tagsList.querySelector(`#${el.id}`);
    if (item != null) item.classList.remove('selected');
    console.log('Removed', value);
  }
</script>

<style>
  * {
    box-sizing: border-box;
  }
  .tags-field {
    /* background-color: rgba(210, 210, 210, 0.85); */
    border: 1px solid rgb(39, 39, 42);
    border-radius: 0.25rem;
    padding: 0.5rem;
    width: 100%;
    display: flex;
    gap: 0.25rem;
    cursor: text;
  }
  .tags-field.focus {
    outline: 2px solid white;
  }
  .tags-input {
    border: none;
    box-shadow: none;
    outline: none;
    background-color: transparent;
    padding: 0 6px;
    margin: 0;
    width: auto;
    max-width: inherit;
  }
  .tags-list {
    margin: 0;
    padding: 0;
    border: 1px solid rgb(39, 39, 42);
    outline: 2px solid white;
    border-radius: 0.25rem;
    max-height: 300px;
    overflow-y: scroll;
  }
  .item {
    padding: 1rem;
    position: relative;
    cursor: pointer;
    border: 1px solid transparent;
  }
  .item:hover,
  .item.highlighted {
    border: 1px solid #999999;
    background-color: lightgray;
  }
  .item.selected {
    border: 1px solid #999999;
    background-color: lightblue;
  }
  :global(.tag) {
    white-space: nowrap;
    border: 1px solid #a9a9a9;
    border-radius: 0.25rem;
    background-color: #ededed;
    color: black;
    cursor: default;
  }
  :global(.tag:hover) {
    border: 1px solid black;
  }
  :global(.tag-label) {
    display: inline-block;
  }
  :global(.remove) {
    width: 1rem;
    height: 1rem;
    padding: 0.25rem;
    cursor: pointer;
    font-size: 1.4rem;
    color: #a9a9a9;
  }
  :global(.remove:hover) {
    color: black;
  }
  .width-full {
    width: 100%;
  }
</style>
